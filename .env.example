# Copy to .env for local dev, or set these as variables in Railway.
# Never commit the real .env (it is gitignored).

# Required: OpenAI key powers lesson content, diagrams, and AI images.
OPENAI_API_KEY=sk-...

# Optional: Unsplash key lets the app fetch photos for new topics.
UNSPLASH_ACCESS_KEY=

# Optional: enables teacher-reviewed, age-aware YouTube suggestions.
# LessonScope never downloads or proxies videos; it stores approved video IDs.
YOUTUBE_API_KEY=

# Optional: enables "Save to Google Drive" for generated PowerPoint decks.
# In Google Cloud, add this redirect URI:
# https://lesson.educscope.com/integrations/google-drive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override if the public LessonScope URL changes.
GOOGLE_REDIRECT_ORIGIN=https://lesson.educscope.com

# Optional: set false if your school mainly opens exports in Keynote and wants
# to avoid Keynote's "build order changed" warning. Default keeps animations on.
POWERPOINT_ANIMATIONS=true

# Optional: set false if your school mainly opens exports in Keynote or Google
# Slides and wants YouTube cards as thumbnail+link only. Default lets supported
# PowerPoint versions play approved online videos inside the presentation.
POWERPOINT_ONLINE_VIDEO=true

# Required in production: a long random string that signs login cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# The email that should have admin rights (can add images to the library).
ADMIN_EMAIL=mphoeduc@gmail.com

# Optional protected code rollback in Admin > Updates and rollback.
# Use a fine-grained GitHub token restricted to this repository with
# Contents: Read and write. Keep both secrets in Railway, never in Git.
ROLLBACK_GITHUB_REPO=mphoswaga/image-server
GITHUB_ROLLBACK_TOKEN=
ROLLBACK_VERIFICATION_CODE=
ROLLBACK_GITHUB_BRANCH=main

# Where mutable data (accounts, templates) is stored. Locally defaults to ./data.
# In production set this to a mounted persistent volume so data survives redeploys.
DATA_DIR=

# Optional, off by default: enables the isolated LessonScope Practice pilot.
# Turn on only for controlled testing after student/teacher checks pass.
PRACTICE_ENABLED=false

# Optional model overrides.
# OPENAI_MODEL=gpt-4o-mini
# Lesson planning and objective-coverage review use a stronger model independently.
# OPENAI_LESSON_MODEL=gpt-4.1
# OPENAI_DIAGRAM_MODEL=gpt-4o

# Controlled pilot: plan-linked outlines, native tables and export checks.
# Off by default; saved aligned decks retain their export checks when disabled.
LESSON_PLAN_DECKS=0
# Only normal lessons with approved plan text use this path; projects/tests
# retain their established assessment generation. It uses OPENAI_LESSON_MODEL.
# Failed outline/content/export checks keep the saved plan and release the
# generation reservation. Review external game/worksheet preparation and pacing.
# Before enabling broadly: render pilot exports in the school presentation app.
# Disable this flag to roll back new generation; existing decks stay editable.
