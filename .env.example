# Copy to .env for local dev, or set these as variables in Railway.
# Never commit the real .env (it is gitignored).

# Required: OpenAI key powers lesson content, diagrams, and AI images.
OPENAI_API_KEY=sk-...

# Optional: Unsplash key lets the app fetch photos for new topics.
UNSPLASH_ACCESS_KEY=

# Optional: enables teacher-reviewed, age-aware YouTube suggestions.
# LessonScope never downloads or proxies videos; it stores approved video IDs.
YOUTUBE_API_KEY=

# Optional: enables "Save to Google Drive" for generated PowerPoint decks.
# In Google Cloud, add this redirect URI:
# https://lesson.educscope.com/integrations/google-drive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required in production: a long random string that signs login cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# The email that should have admin rights (can add images to the library).
ADMIN_EMAIL=mphoeduc@gmail.com

# Where mutable data (accounts, templates) is stored. Locally defaults to ./data.
# In production set this to a mounted persistent volume so data survives redeploys.
DATA_DIR=

# Optional model overrides.
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_DIAGRAM_MODEL=gpt-4o
